<?xml version="1.0" encoding="utf-8"?><!--
    Dark counterpart of Theme.NvGtk (values-night, picked automatically when the
    system is in dark mode and on activity recreation after a mode switch).
    Parent = raw platform Material dark; windowBackground = Catppuccin Mocha
    `base` (#1E1E2E), pitch-matched to the Compose dark surface so the boot
    frame / day-night switch never flashes white.
-->
<resources>
    <style name="Theme.NvGtk" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#FF1E1E2E</item>
    </style>
</resources>